DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres


# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The URL the app is served from (http://localhost:3000 locally)
BETTER_AUTH_URL=http://localhost:3000

# Supabase Storage (S3-compatible). Project Settings > Storage > S3 Connection. Server-side only.
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=uploads



# Meta Model API (https://dev.meta.ai/docs) - OpenAI-compatible Chat Completions
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Lets a scheduler call POST /api/jobs/drain with "Authorization: Bearer <secret>". Generate with: openssl rand -base64 32
JOBS_DRAIN_SECRET=

# Admin (read-only observer)
ADMIN_EMAILS=
ADMIN_EMAIL=
ADMIN_PASSWORD=
